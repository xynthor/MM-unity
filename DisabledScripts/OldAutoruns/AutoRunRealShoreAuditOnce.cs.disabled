using UnityEditor;
using UnityEditor.SceneManagement;
using System.IO;

[InitializeOnLoad]
public static class AutoRunRealShoreAuditOnce
{
    const string Flag="Validation/REAL_SHORE_AUDIT_DONE.txt";
    static AutoRunRealShoreAuditOnce(){EditorApplication.delayCall+=Run;}
    static void Run()
    {
        if(File.Exists(Flag)) return;
        try{
            MMSourceGridExactPostPass.ApplyAll();
            AuditOneToOneWorld.Run();
            AuditWorldSourceExact.Run();
            CaptureAuditScreens.Run();
            BuildEnrothLinkedOpenWorld.Build();
            File.WriteAllText(Flag,"DONE");
        }catch(System.Exception e){UnityEngine.Debug.LogException(e);File.WriteAllText("Validation/REAL_SHORE_AUDIT_FAILED.txt",e.ToString());}
    }
}