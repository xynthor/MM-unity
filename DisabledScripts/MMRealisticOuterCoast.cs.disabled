using UnityEditor;
using UnityEngine;
using System;
using System.IO;
using System.Collections.Generic;
using System.Linq;

public static class MMRealisticOuterCoast
{
    const int N=128;
    const int Along=128;
    const int Across=16;
    const float Cell=4f;
    const float WaterY=.12f;
    const string MatRoot="Assets/Materials/SourceGridTerrain";
    enum Edge { North, South, West, East }

    public static void Build(string key,string display,Transform root,Terrain terrain,byte[] tilemap,byte[] groups,byte[] sem)
    {
        bool north=key=="SweetWater"||key=="Kriegspire"||key=="FrozenHighlands"||key=="SilverCove"||key=="EelInfestedWaters";
        bool south=key=="HermitsIsle"||key=="Dragonsand"||key=="MireOfTheDamned"||key=="CastleIronfist"||key=="NewSorpigal";
        bool west=key=="SweetWater"||key=="ParadiseValley"||key=="HermitsIsle";
        bool east=key=="EelInfestedWaters"||key=="MistyIslands"||key=="NewSorpigal";
        var old=root.Find("Outer Ocean + Shore Extension"); if(old) UnityEngine.Object.DestroyImmediate(old.gameObject);
        if(!north&&!south&&!west&&!east) return;
        var coast=new GameObject("Outer Ocean + Shore Extension"); coast.transform.SetParent(root,false);
        if(north) BuildEdge(key,display,coast.transform,terrain,tilemap,groups,sem,Edge.North);
        if(south) BuildEdge(key,display,coast.transform,terrain,tilemap,groups,sem,Edge.South);
        if(west) BuildEdge(key,display,coast.transform,terrain,tilemap,groups,sem,Edge.West);
        if(east) BuildEdge(key,display,coast.transform,terrain,tilemap,groups,sem,Edge.East);        if(north&&west) MakeCorner(key,coast.transform,"NW",-320,-256,256,320);
        if(north&&east) MakeCorner(key,coast.transform,"NE",256,320,256,320);
        if(south&&west) MakeCorner(key,coast.transform,"SW",-320,-256,-320,-256);
        if(south&&east) MakeCorner(key,coast.transform,"SE",256,320,-320,-256);
        Debug.Log($"REALISTIC_COAST {display} N={north} S={south} W={west} E={east} squareBased=true");
    }

    static void EdgeSource(Edge e,int i,out int sx,out int sy)
    {
        int q=Mathf.Clamp(i,0,N-1);
        if(e==Edge.North){sx=q;sy=N-1;return;}
        if(e==Edge.South){sx=q;sy=0;return;}
        if(e==Edge.West){sx=0;sy=q;return;}
        sx=N-1;sy=q;
    }
    static void EdgeWorld(Edge e,float along,float d,out float x,out float z)
    {
        if(e==Edge.North){x=along;z=256f+d;return;}
        if(e==Edge.South){x=along;z=-256f-d;return;}
        if(e==Edge.West){x=-256f-d;z=along;return;}
        x=256f+d;z=along;
    }
    static void InnerWorld(Edge e,float along,out float x,out float z)
    {
        if(e==Edge.North){x=along;z=255.25f;return;}
        if(e==Edge.South){x=along;z=-255.25f;return;}
        if(e==Edge.West){x=-255.25f;z=along;return;}
        x=255.25f;z=along;
    }
    static bool IsLand(byte[] tm,byte[] sem,int sx,int sy)
    {
        byte raw=tm[Mathf.Clamp(sy,0,N-1)*N+Mathf.Clamp(sx,0,N-1)];
        return (sem[raw]&1)==0;
    }    static byte Group(byte[] tm,byte[] groups,int sx,int sy)
    {
        byte raw=tm[Mathf.Clamp(sy,0,N-1)*N+Mathf.Clamp(sx,0,N-1)];
        return groups[raw];
    }
    static float Hash01(int a,int b,int c)
    {
        unchecked{uint x=(uint)(a*73856093^b*19349663^c*83492791);x^=x>>13;x*=1274126177u;x^=x>>16;return (x&0xffff)/65535f;}
    }
    static float RawShelf(byte[] tm,byte[] groups,byte[] sem,Edge e,int i)
    {
        EdgeSource(e,i,out int sx,out int sy); if(!IsLand(tm,sem,sx,sy)) return 0f;
        byte g=Group(tm,groups,sx,sy); float w=10f+Hash01(sx,sy,(int)e)*14f;
        if(g==2)w+=8f; else if(g==7)w+=5f; else if(g==1)w-=2f; else if(g==3||g==6)w-=4f;
        return Mathf.Clamp(w,5f,31f);
    }
    static float Shelf(byte[] tm,byte[] groups,byte[] sem,Edge e,int i)
    {
        float sum=0f,ws=0f;
        for(int k=-2;k<=2;k++){int q=Mathf.Clamp(i+k,0,N-1);float w=RawShelf(tm,groups,sem,e,q);float a=3-Mathf.Abs(k);sum+=w*a;ws+=a;}
        return sum/ws;
    }
    static float BeachEnd(byte[] tm,byte[] groups,byte[] sem,Edge e,int i,float slope)
    {
        EdgeSource(e,i,out int sx,out int sy); byte g=Group(tm,groups,sx,sy);
        float extra=slope>32f?5f:9f+Hash01(sx+17,sy+31,(int)e)*8f;
        if(g==2)extra+=5f; if(g==3||g==6)extra-=2f;
        return Mathf.Clamp(Shelf(tm,groups,sem,e,i)+extra,8f,46f);
    }
    static int GroundSlot(byte g)
    {
        if(g==1)return 1; if(g==2)return 2; if(g==3)return 3; if(g==4)return 4; if(g==6)return 5; if(g==7)return 6; return 0;
    }
    static float ProfileY(Terrain t,byte[] tm,byte[] groups,byte[] sem,Edge e,int i,float along,float d)
    {
        EdgeSource(e,i,out int sx,out int sy); InnerWorld(e,along,out float ix,out float iz);
        float inner=t.SampleHeight(new Vector3(ix,0,iz))+t.transform.position.y;
        bool land=IsLand(tm,sem,sx,sy); if(!land)return Mathf.Lerp(Mathf.Min(inner,-.25f),-4.8f,Mathf.SmoothStep(0,1,d/64f));
        float nx=(ix-t.transform.position.x)/t.terrainData.size.x,nz=(iz-t.transform.position.z)/t.terrainData.size.z;
        float slope=t.terrainData.GetSteepness(Mathf.Clamp01(nx),Mathf.Clamp01(nz)); float shelf=Shelf(tm,groups,sem,e,i),be=BeachEnd(tm,groups,sem,e,i,slope);
        if(d<=shelf){float y0=Mathf.Min(inner,slope>32f?3.2f:1.6f);float n=(Hash01(i,Mathf.RoundToInt(d),17)-.5f)*.25f;return Mathf.Lerp(inner,y0,Mathf.SmoothStep(0,1,d/Mathf.Max(1,shelf)))+n;}
        if(d<=be)return Mathf.Lerp(slope>32f?.55f:.75f,.06f,Mathf.SmoothStep(0,1,(d-shelf)/Mathf.Max(1,be-shelf)));
        return Mathf.Lerp(.02f,-4.8f,Mathf.SmoothStep(0,1,(d-be)/Mathf.Max(1,64f-be)));
    }