using UnityEditor;
using UnityEngine;
using System;
using System.IO;

[InitializeOnLoad]
public static class AutoRunWorldPolishFinal2
{
    const string Flag="Validation/WORLD_POLISH_FINAL2_20260916_DONE.txt";
    const string Fail="Validation/WORLD_POLISH_FINAL2_20260916_FAILED.txt";
    static AutoRunWorldPolishFinal2(){EditorApplication.delayCall+=Run;}
    static void Run()
    {
        if(File.Exists(Flag)||EditorApplication.isCompiling||EditorApplication.isUpdating)return;
        try
        {
            File.Delete(Fail); Debug.Log("WORLD_POLISH_FINAL2_BEGIN");
            MMSourceGridExactPostPass.ApplyAll();
            MMWorldPolishPass.ApplyAll();
            AuditTextureWorld.Run();
            CaptureAuditScreens.Run();
            BuildEnrothLinkedOpenWorld.Build();
            Directory.CreateDirectory("Validation");
            File.WriteAllText(Flag,DateTime.Now.ToString("O"));
            Debug.Log("WORLD_POLISH_FINAL2_DONE");
        }
        catch(Exception e){Directory.CreateDirectory("Validation");File.WriteAllText(Fail,e.ToString());Debug.LogException(e);}
    }
}
